{
  "name": "grithub",
  "version": "2.0.16",
  "private": true,
  "description": "LeetHub 2.0 for Firefox + a spaced-repetition interview-prep tracker (fork of Siddharth Rayabharam's LeetHub 2.0 for Firefox)",
  "scripts": {
    "dev": "webpack --mode=production --watch",
    "setup": "npm i",
    "format": "prettier --write **/*.{js,jsx,ts,tsx,css,html}",
    "format-test": "prettier --check **/*.{js,jsx,ts,tsx,css,html}",
    "lint": "eslint **/*.{js,ts} --fix",
    "lint-test": "eslint **/*.{js,ts} --color",
    "build": "webpack --mode=production"
  },
  "devDependencies": {
    "chrome-types": "^0.1.282",
    "copy-webpack-plugin": "^12.0.2",
    "filemanager-webpack-plugin": "^8.0.0",
    "ignore-loader": "^0.1.2",
    "jest": "^29.7.0",
    "prettier": "^2.2.1",
    "puppeteer": "^22.11.2",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "chart.js": "^4.4.7"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
