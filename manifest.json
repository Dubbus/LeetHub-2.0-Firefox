{
  "manifest_version": 3,
  "name": "GritHub",
  "description": "Auto-sync LeetCode/GeeksforGeeks solutions to GitHub, plus a spaced-repetition interview-prep tracker and dashboard. A fork of LeetHub 2.0 for Firefox by Siddharth Rayabharam.",
  "homepage_url": "https://github.com/Dubbus/GritHub",
  "version": "__LH_VERSION__",
  "author": "Dubbus",
  "action": {
    "default_icon": "assets/thumbnail.png",
    "default_popup": "popup.html",
    "default_title": "GritHub: sync LeetCode solutions to GitHub + track interview prep"
  },
  "icons": {
    "16": "assets/thumbnail.png",
    "48": "assets/thumbnail.png",
    "128": "assets/thumbnail.png"
  },
  "background": {
    "scripts": ["scripts/background.js"]
  },
  "permissions": [
    "unlimitedStorage",
    "storage",
    "webNavigation"
  ],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["scripts/browserutil.js", "scripts/leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["scripts/browserutil.js", "scripts/authorize.js"]
    },
    {
      "matches": ["https://practice.geeksforgeeks.org/*"],
      "js": ["scripts/browserutil.js", "scripts/gfg.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "grithub@dubbus"
    }
  }
}
